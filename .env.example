# Public site URL (no trailing slash) — used for canonical & Open Graph URLs
VITE_SITE_URL=https://www.cabes.cm

# Backend API base URL (no trailing slash). See server/ for the API itself.
VITE_API_URL=http://localhost:4000

# Privacy-friendly analytics (Plausible). Leave empty to disable.
# https://plausible.io — no cookies, GDPR-friendly
VITE_PLAUSIBLE_DOMAIN=
# Optional: custom script URL (self-hosted Plausible)
# VITE_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js
