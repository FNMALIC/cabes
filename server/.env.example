# MongoDB connection string (Atlas or self-hosted). Include the database name in the path.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cabes_dev?retryWrites=true&w=majority"

PORT=4000
NODE_ENV=development

# Long random string used to sign admin session JWTs
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=12h

COOKIE_NAME=cabes_admin_session
# Leave empty in local dev. In production, set to the shared root domain, e.g. ".cabes-cm.com"
COOKIE_DOMAIN=

# Seed credentials for the single admin account (used by `npm run db:seed`)
ADMIN_EMAIL=admin@cabes-cm.com
ADMIN_PASSWORD=change-me-before-seeding

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
